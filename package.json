{
  "name": "infinite-chs",
  "version": "1.0.0",
  "description": "Infinite — Simplified Co-operative Accounting for Mumbai Housing Societies. Made by Narendra Panchal.",
  "author": "Narendra Panchal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh-pages": "node scripts/export-gh-pages.js",
    "deploy:gh-pages": "node scripts/export-gh-pages.js && gh-pages -d out --dotfiles --nojekyll -b gh-pages",
    "start": "next start",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "setup": "npx prisma db push && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "exceljs": "^4.4.0",
    "next": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
